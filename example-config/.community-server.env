# CONFIG_VERSION=4
# Bumped automatically by .github/workflows/sync-config.yml on every push
# that changes this file. Do not edit this line by hand.

# Valid string values like dev,development,prod,staging
INSTANCE=<instance>
# Deployed instance full URL string
BASE_URL=<URL of the server>

# Postgres Database full connection URL string
DISCUSSION_DATABASE_URL=<Discussion Database URL>
CHALLENGE_DATABASE_URL=<Challenge Database URL>
# Postgres Database schema name string
DISCUSSION_DB_SCHEMA=<Discussion Schema Name>
CHALLENGE_DB_SCHEMA=<Challenge Schema Name>

# Keycloak related values
KEYCLOAK_URL=<URL of the Keycloak>
KEYCLOAK_REALM=<realm>
KEYCLOAK_AUDIENCE=<audience>
KEYCLOAK_ISSUER=<issuer>

# S3 Bucket name string (no URL)
DISCUSSION_S3_BUCKET=<Discussion Bucket Name>
CHALLENGE_S3_BUCKET=<Challenge Bucket Name>

# aws access and secret keys
S3_ACCESS_KEY_ID=<access key id>
S3_SECRET_ACCESS_KEY=<secret access key>

# aws default region string
S3_DEFAULT_REGION=<region>

# S3 endpoint URL
S3_ENDPOINT_URL=<endpoint>

# redis full connection URL string (standalone / cluster mode)
REDIS_URL=<URL of the Redis>
# Set to true when REDIS_URL points at a Redis Cluster
REDIS_CLUSTER_ENABLED=false
# Redis Sentinel mode -- set REDIS_SENTINEL_ENABLED=true to use it instead of
# REDIS_URL. Nodes are comma-separated host:port pairs.
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_NODES=<sentinel-0:26379,sentinel-1:26379,sentinel-2:26379>
REDIS_SENTINEL_MASTER_NAME=mymaster
# Optional: auth for the sentinels themselves
REDIS_SENTINEL_PASSWORD=
# Optional: auth and database for the master found via the sentinels
REDIS_PASSWORD=
REDIS_DB=0
# Array of enabled services :- ["DISCUSSION", "CHALLENGE"] or ["DISCUSSION"] or ["CHALLENGE"]
ACTIVATED_SERVICES=["DISCUSSION", "CHALLENGE"]

ALLOWED_ORIGINS=[""]
