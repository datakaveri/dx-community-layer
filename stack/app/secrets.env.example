# Application Secrets Configuration
# ==================================
# Copy this file to secrets.env and fill in your values

# PostgreSQL Configuration (shared by both services)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=

# Database Names
DISCUSSION_DB_NAME=
CHALLENGE_DB_NAME=

# Database Schemas
DISCUSSION_DB_SCHEMA=
CHALLENGE_DB_SCHEMA=

# Redis Configuration
REDIS_URL=

# Keycloak Authentication Configuration
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_AUDIENCE=
KEYCLOAK_ISSUER=

# S3 Configuration
DISCUSSION_S3_BUCKET=
CHALLENGE_S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_REGION=
