# Application Secrets Configuration
# ==================================
# Copy this file to secrets.env and fill in your values

# PostgreSQL Configuration (shared by both services)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=

# Database Names
DISCUSSION_DB_NAME=
CHALLENGE_DB_NAME=

# Database Schemas
DISCUSSION_DB_SCHEMA=
CHALLENGE_DB_SCHEMA=

# Redis Configuration
REDIS_URL=

# Keycloak Authentication Configuration
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_AUDIENCE=
KEYCLOAK_ISSUER=

# AWS S3 Configuration
DISCUSSION_AWS_S3_BUCKET=
CHALLENGE_AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
